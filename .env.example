# Copiar como .env.local solo si necesitas cambiar algo (no se sube a GitHub).
#
# URL base de la API. Por defecto es /api/v1 y el proxy de Vite la reenvía al
# Gateway (http://localhost:8080). Para apuntar directo al Gateway sin proxy:
# VITE_API_URL=http://localhost:8080/api/v1
#
# Dirección del Gateway que usa el proxy de Vite (npm run dev):
# VITE_PROXY_TARGET=http://localhost:8080
